{
  "name": "aura-learning-os",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed-catalog": "tsx scripts/seed-catalog.ts",
    "db:reset": "tsx scripts/reset-demo.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:maintain": "tsx scripts/maintain-db.ts",
    "user:create": "tsx scripts/create-user.ts",
    "invite:create": "tsx scripts/create-invite.ts",
    "invite:list": "tsx scripts/list-invites.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
