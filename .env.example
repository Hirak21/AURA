# ---------------------------------------------------------------------------
# AURA environment template. Copy to .env.production (never commit it).
#
#   cp .env.example .env.production
#   chmod 600 .env.production
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Canonical public origin. Used for metadata/OG URLs and cookie expectations.
AURA_PUBLIC_URL=https://aura.example.edu

# Absolute path to the SQLite file. Keep it outside the release directory so a
# deploy does not overwrite data. The directory must be writable by the app user.
AURA_DB_PATH=/home/aagomon/aura/shared/data/aura.db

# Backups (used by `npm run db:backup`)
AURA_BACKUP_DIR=/home/aagomon/aura/shared/backups
AURA_BACKUP_KEEP=14

# Authentication
# Demo identity switching must be OFF on any internet-facing deployment.
AURA_DEMO_MODE=false
# true = Secure cookies. Keep true behind HTTPS (required in production).
AURA_COOKIE_SECURE=true
# Set false only if Node is exposed directly without a reverse proxy.
AURA_TRUST_PROXY=true

# Password used for the fictional demo accounts created by `npm run db:init`.
# Change it if you initialise a demo database anywhere public.
AURA_SEED_PASSWORD=aura-demo-2026

# Optional: used by `npm run user:create` when --password is omitted.
# AURA_NEW_USER_PASSWORD=

# Optional: move the session/rate-limit store to a shared backend if AURA ever
# runs as more than one instance. Not implemented; see docs/DATABASE.md.
# REDIS_URL=
